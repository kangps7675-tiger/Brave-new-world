{
  "name": "brave-new-world",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-cesium-assets.mjs",
    "cesium:assets": "node scripts/copy-cesium-assets.mjs",
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "dev:webpack": "next dev",
    "dev:clean": "node scripts/clean-next.js && next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-cesium-assets.mjs && node scripts/stamp-sw-version.mjs",
    "build": "node scripts/ci-build.js",
    "build:next": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:reduced-motion": "node scripts/check-reduced-motion.mjs",
    "verify:ui-tokens": "node scripts/check-ui-tokens.mjs",
    "verify:i18n": "node scripts/check-i18n.mjs",
    "verify:syntax": "node scripts/check-syntax.mjs",
    "verify:security": "node scripts/check-security.mjs",
    "verify:maplibre": "node scripts/check-maplibre-expr.mjs",
    "verify:dialog-a11y": "node scripts/check-dialog-a11y.mjs",
    "verify:commercial": "node scripts/verify-commercial-licensing.js",
    "verify:commercial:paid": "COMMERCIAL_TIER_ENABLED=true node scripts/verify-commercial-licensing.js",
    "corridors:portwatch": "node scripts/portwatch/fetch-ports.js",
    "corridors:chokepointtransit": "node scripts/chokepoints/parse-chokepoint-transit.js",
    "corridors:chokepointtransit:fetch": "node scripts/chokepoints/fetch-chokepoint-transit.js",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:local": "wrangler d1 migrations apply conflict-view-db --local -c wrangler.ingest.toml",
    "db:migrate:remote": "wrangler d1 migrations apply conflict-view-db --remote -c wrangler.ingest.toml",
    "cf:ingest:dev": "wrangler dev -c wrangler.ingest.toml",
    "cf:ingest:deploy": "wrangler deploy -c wrangler.ingest.toml",
    "cf:ingest:tail": "wrangler tail -c wrangler.ingest.toml",
    "cf:d1:migrate:local": "npm run db:migrate:local",
    "cf:d1:migrate:remote": "npm run db:migrate:remote",
    "cf:app:build": "opennextjs-cloudflare build",
    "cf:app:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:app:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:app:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:ci-deploy": "node scripts/ci-deploy.js",
    "cf:r2:create": "wrangler r2 bucket create conflict-view-data",
    "cf:r2:upload": "node scripts/r2-upload-data.js",
    "cf:r2:upload:dry": "node scripts/r2-upload-data.js --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium --project=webkit",
    "test:e2e:chromium": "playwright test --project=chromium",
    "verify:workers-assets": "node scripts/verify-workers-asset-size.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@block65/webcrypto-web-push": "^1.0.2",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@deck.gl/mesh-layers": "^9.3.10",
    "@google/earthengine": "^1.7.48",
    "@loaders.gl/3d-tiles": "^4.5.4",
    "@loaders.gl/core": "^4.5.4",
    "@openhistoricalmap/maplibre-gl-dates": "^1.4.0",
    "@streamparser/json": "^0.0.26",
    "@vercel/analytics": "^2.0.1",
    "adm-zip": "0.6.1",
    "cesium": "1.146.0",
    "drizzle-orm": "^0.45.4",
    "fast-uri": "3.1.8",
    "fflate": "^0.8.3",
    "fuse.js": "^7.4.2",
    "h3-js": "^4.5.0",
    "iconv-lite": "^0.7.3",
    "maplibre-gl": "^6.14.0",
    "next": "14.2.35",
    "pmtiles": "^4.5.0",
    "polygon-clipping": "^0.15.7",
    "react": "^18",
    "react-dom": "^18",
    "react-map-gl": "^8.1.3",
    "satellite.js": "6.0.2",
    "shapefile": "^0.6.6",
    "tsconfig-paths": "^3.15.0",
    "yahoo-finance2": "^3.15.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@opennextjs/cloudflare": "1.15.1",
    "@playwright/test": "^1.64.1",
    "@types/adm-zip": "^0.6.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "mapshaper": "^0.7.87",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.1",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "better-sqlite3": "12.11.1"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "adm-zip": "0.6.1",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "nanoid": "^3.3.17",
    "node-forge": ">=1.3.3",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
