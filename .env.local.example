# 서버 전용 — NEXT_PUBLIC_ 접두사를 붙이면 브라우저 번들에 노출됩니다.

# 외부 API stub (true=로컬 시드·가벼움, false=라이브 프록시)
# false 시 liveRenderGuard가 폴링 간격·FIRMS/AIS/ADS-B 상한을 자동으로 보수화합니다.
API_STUB_MODE=true

# 데이터 프로필: lite | full
DATA_PROFILE=lite

# R2 public CDN (정적 JSON + audio/) — 없으면 로컬 public/
# NEXT_PUBLIC_DATA_CDN=https://<your-r2-public-host>


# 레이어 플래그 (서버에서 판단, 클라이언트는 page.tsx 주입)
# NEPTUN_ENABLED=true
# TZEVA_ADOM_ENABLED=true
TELEGRAM_OSINT_ENABLED=true

# 데이터 동기화 폴링 간격(ms) — 선택
# SYNC_POLL_MS=300000

# API 키 (절대 NEXT_PUBLIC_ 금지)
# AISSTREAM_API_KEY=
# MarineTraffic / Kpler AIS (swagger exportvessels) — 지경학 민간 선박 보강
# MARINETRAFFIC_API_KEY=
# FIRMS_MAP_KEY=          # NASA FIRMS MAP_KEY (권장 이름)
# NASA_FIRMS_API_KEY=     # 동일 키 별칭 — 둘 중 하나만 있으면 됨
# ADSBexchange gateway 군용기 — header: x-api-key + Accept-Encoding: gzip
# ADSBEXCHANGE_API_KEY=
# ADSB_API_KEY=           # 별칭
# ADSBEXCHANGE_MIL_URL=   # 기본 https://gateway.adsbexchange.com/api/aircraft/v2/mil
# Freesound HQ mp3 프리뷰 (/api/sound-stream) — NEXT_PUBLIC_ 붙이지 말 것
# FREESOUND_API_KEY=

# FRED — Federal Reserve Bank of St. Louis (api.stlouisfed.org)
# FININT 티커의 **원자재·달러 보완** 소스 (WTI·브렌트·천연가스 Henry Hub·금·달러인덱스).
# 주요 증시 지수(VIX·S&P·나스닥·아시아)는 Yahoo Finance 15분 폴링이 담당.
# 키가 없으면 원자재도 Yahoo로 폴백.
# 무료 키 발급: https://fred.stlouisfed.org/docs/api/api_key.html (서버 전용, NEXT_PUBLIC_ 금지)
# FRED_API_KEY=

# World Bank Open Data (api.worldbank.org) — 국가 클릭 시 "지국 경제 위험도" (키 불필요)
# GDP성장·물가·실업·정부부채·경상수지 → /api/world-bank/country?iso=KOR

# Statistics of the World API Pro — 양피지 GDP·인구 카드 + /api/world-stats/*
# Docs: https://statisticsoftheworld.com/api-docs · Data bundle: https://statisticsoftheworld.com/data
# Header: X-API-Key (서버 전용, NEXT_PUBLIC_ 금지)
# STATSOFTHEWORLD_API_KEY=

# UCDP GED — 빌드 타임 분쟁 사건 갱신 전용 (런타임 아님)
# Header: x-ucdp-access-token · https://ucdpapi.pcr.uu.se/api/gedevents/26.1
# 채운 뒤 npm run data:ucdp 실행 → ucdp-events.json 갱신
# UCDP_ACCESS_TOKEN=

# Anthropic Claude Messages API — 서버 등불 풀이쓰기/편집 digest 전용
# 유저 「분석」은 BYOK 경로이며 이 키를 사용하지 않음
# ANTHROPIC_API_KEY=
# LLM_NEWS_DIGEST_ENABLED=false
# LLM_DAILY_LAMP_ENABLED=true  # false면 등불 LLM 풀이쓰기 비활성
# ANTHROPIC_MODEL=claude-sonnet-4-6

# HDX HAPI — 전선 사망 오버레이 (/api/hapi-conflict-casualties)
# 원천: ACLED (Armed Conflict Location & Event Data Project) · www.acleddata.com
# API: https://hapi.humdata.org/api/v2/coordination-context/conflict-events
# Docs: https://hapi.humdata.org/docs · Dataset: https://data.humdata.org/dataset/hdx-hapi-conflict-event
# Base64 app_name:email
# HAPI_APP_IDENTIFIER=

# Telegram MTProto (my.telegram.org) — Python 수집기: npm run telegram:auth
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=+8210xxxxxxxx
# TELEGRAM_USE_EMBED=true   # true=공개 embed(키 불필요), false 시에도 웹은 embed 가능·MTProto는 스크립트용


# Weekly ship moves admin (/admin/ship-movements) — server only
# SHIP_MOVEMENT_ADMIN_SECRET=
# Warm cron auth: INGEST_CRON_SECRET or SHIP_MOVEMENT_WARM_SECRET
# SHIP_MOVEMENT_WARM_SECRET=

# Cloudflare Radar Outage Center — /api/radar-outages (서버 전용)
# https://developers.cloudflare.com/radar/get-started/first-request/
# CLOUDFLARE_RADAR_TOKEN=

# Cesium ion — 지형 모드 줌≥14 OSM 3D Buildings (브라우저에서 타일 fetch, 세슘 뷰어 아님)
# https://ion.cesium.com → Access Tokens
# 없으면 OpenFreeMap fill-extrusion 상자 건물로 폴백
# CESIUM_ION_TOKEN=

# CRINK hub thumbs — optional Sentinel Hub (NASA GIBS works without key)
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=

# Globe thumb bake (scripts/bake-globe-thumbs.mjs) — /internal/globe-thumb gate
# GLOBE_THUMB_BAKE_TOKEN=
