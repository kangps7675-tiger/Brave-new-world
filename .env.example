# 환경 변수 템플릿 안내
#
# 이 파일은 복사용이 아닙니다. Next.js와 Wrangler(Workers)가 분리되어 있습니다.
#
#   Next.js (앱)     →  .env.local.example  를 복사해  .env.local  로 사용
#   Wrangler (cron)  →  .dev.vars.example   를 복사해  .dev.vars   로 사용
#
# stub OFF 전제조건: docs/stub-off-checklist.md
# 문서 vs 코드 정본: docs/deferred-status.md
# OpenSky OAuth2 client credentials (server only)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# LIVEUAMAP — Next .env.local 에 LIVEUAMAP_API_KEY / LIVEUAMAP_RESID_MAP / LIVEUAMAP_DAILY_BUDGET
# Cron: .dev.vars 에 LIVEUAMAP_SYNC_URL=http://127.0.0.1:3000/api/liveuamap/sync
